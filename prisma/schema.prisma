// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  fullName     String
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  
  // Relación 1:1 con el perfil de estilo de vida
  profile      LifestyleProfile? 
}

model LifestyleProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Presupuesto mensual en MXN
  minBudget        Float
  maxBudget        Float
  
  // Zonas de preferencia en Querétaro (Array de strings)
  preferredZones   String[]
  
  // Hábitos y preferencias de convivencia
  hasPets          Boolean  @default(false)
  toleratesPets    Boolean  @default(true)
  isSmoker         Boolean  @default(false)
  toleratesSmokers Boolean  @default(false)
  
  // Biografía corta para el feed
  bio              String?  @db.Text
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}